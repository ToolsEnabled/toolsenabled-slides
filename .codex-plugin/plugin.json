{
  "name": "toolsenabled-slides",
  "version": "0.1.9",
  "description": "Build and edit real PowerPoint decks with a live local studio and human pause and undo controls.",
  "author": {
    "name": "ToolsEnabled, Inc.",
    "email": "support@toolsenabled.ai",
    "url": "https://toolsenabled.ai"
  },
  "mcpServers": {
    "slides": {
      "command": "node",
      "args": [
        "./slides-mcp.js"
      ],
      "cwd": "./",
      "env": {
        "SLIDES_PLUGIN_MODE": "1"
      },
      "env_vars": [
        "SLIDES_WORKSPACE",
        "SUITE_PYTHON",
        "SUITE_PORT",
        "SLIDES_RENDERER",
        "SLIDES_SOFFICE",
        "SUITE_ALLOWED_ORIGINS",
        "SUITE_HEADERS_TIMEOUT_MS",
        "SUITE_REQUEST_BODY_TIMEOUT_MS",
        "SUITE_MCP_HTTP_TIMEOUT_MS"
      ]
    }
  },
  "interface": {
    "displayName": "ToolsEnabled Slides",
    "shortDescription": "Local PowerPoint deck editing",
    "longDescription": "Create, import and export PowerPoint decks through a local MCP server. Watch changes in the browser studio, pause editing and undo changes. Supports LibreOffice PDF and PNG export.",
    "defaultPrompt": [
      "Build a three-slide project update, then export it as PowerPoint and PDF."
    ],
    "developerName": "ToolsEnabled, Inc.",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://toolsenabled.ai/slides/",
    "supportURL": "https://toolsenabled.ai/support/",
    "privacyPolicyURL": "https://toolsenabled.ai/privacy/"
  },
  "homepage": "https://toolsenabled.ai/slides/",
  "repository": "https://github.com/ToolsEnabled/toolsenabled-slides",
  "license": "MIT",
  "skills": "./skills/",
  "hooks": {}
}
