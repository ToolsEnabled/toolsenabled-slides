{
  "mcpServers": {
    "slides": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/slides-mcp.js"
      ],
      "env": {
        "SLIDES_PLUGIN_MODE": "1",
        "SLIDES_WORKSPACE": "${user_config.workspace_directory}",
        "SUITE_PYTHON": "${user_config.python_executable}",
        "SUITE_PORT": "${user_config.port}",
        "SLIDES_RENDERER": "${user_config.renderer}",
        "SLIDES_SOFFICE": "${user_config.libreoffice_executable}",
        "SUITE_ALLOWED_ORIGINS": "",
        "SUITE_HEADERS_TIMEOUT_MS": "10000",
        "SUITE_REQUEST_BODY_TIMEOUT_MS": "15000",
        "SUITE_MCP_HTTP_TIMEOUT_MS": ""
      }
    }
  }
}
